{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
      "predev": "rimraf .parcel-cache 2>/dev/null || rm -rf .parcel-cache",
      "dev": "parcel public/*.html",
      "prebuild": "rimraf dist .parcel-cache 2>/dev/null || rm -rf dist .parcel-cache",
      "build": "parcel build public/*.html --dist-dir dist",
      "test": "vitest run",
      "typecheck": "tsc --noEmit",
      "lint": "biome check src tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@types/alpinejs": "^3.13.11",
    "@vitest/coverage-v8": "^5.0.4",
    "happy-dom": "^21.0.1",
    "parcel": "^2.16.4",
    "parcel-resolver-path-alias": "^1.0.1",
    "parcel-resolver-tspaths": "^0.0.9",
    "postcss": "^8.5.28",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@parcel/config-default": "^2.16.4",
    "@tailwindcss/postcss": "^4.3.3",
    "alpinejs": "^3.17.3",
    "tailwindcss": "^4.3.3"
  }
}
